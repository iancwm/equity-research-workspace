{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Context",
  "type": "object",
  "required": [
    "company_name",
    "ticker",
    "exchange",
    "research_date",
    "base_currency",
    "forecast_horizon_years",
    "rating_convention"
  ],
  "properties": {
    "company_name": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "exchange": {
      "type": "string"
    },
    "industry": {
      "type": [
        "string",
        "null"
      ]
    },
    "geography": {
      "type": [
        "string",
        "null"
      ]
    },
    "research_date": {
      "type": "string"
    },
    "benchmark": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_currency": {
      "type": "string"
    },
    "forecast_horizon_years": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "rating_convention": {
      "type": "string"
    },
    "special_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existing_state": {
      "type": "boolean"
    }
  }
}