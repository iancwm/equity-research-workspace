{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assumption Record",
  "type": "object",
  "required": [
    "id",
    "name",
    "base",
    "units",
    "owner_node",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "base": {},
    "bear": {},
    "bull": {},
    "units": {
      "type": "string"
    },
    "owner_node": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_updated": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "stale"
      ]
    }
  }
}