{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assumption Collection",
  "type": "object",
  "required": ["assumptions", "scenario_overrides"],
  "properties": {
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assumption"}
    },
    "scenario_overrides": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "$defs": {
    "assumption": {
      "type": "object",
      "required": ["id", "name", "base", "units", "owner_node", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "base": {},
        "bear": {},
        "bull": {},
        "units": {"type": "string"},
        "owner_node": {"type": "string", "minLength": 1},
        "rationale": {"type": ["string", "null"]},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "last_updated": {"type": ["string", "null"], "format": "date"},
        "status": {"enum": ["active", "stale"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
