{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Record",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "source_type",
    "publisher",
    "url_or_ref",
    "publication_date",
    "observation_period",
    "accessed_at",
    "primary_source",
    "quality_tier",
    "notes"
  ],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "url_or_ref": {"type": "string", "minLength": 1},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "observation_period": {"type": ["string", "null"]},
    "accessed_at": {"type": "string", "format": "date"},
    "primary_source": {"type": "boolean"},
    "quality_tier": {"type": "integer", "minimum": 1, "maximum": 4},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
